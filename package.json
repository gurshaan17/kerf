{
  "name": "kerf",
  "productName": "Kerf",
  "version": "0.1.0",
  "private": true,
  "description": "Kerf — a local-first, chat-driven video editor for the desktop.",
  "keywords": [
    "electron",
    "vite",
    "react",
    "typescript",
    "video-editor"
  ],
  "license": "MIT",
  "author": {
    "name": "gurshaan17",
    "email": "gurshaansinghd@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gurshaan17/kerf.git"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "dev": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "build:app": "node scripts/build-app.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build:app && playwright test",
    "test:coverage": "vitest run --coverage",
    "audit:names": "node scripts/audit-names.mjs",
    "clean": "rm -rf out .vite"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "44.9.3",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.89.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.85",
    "@ai-sdk/google": "^4.0.102",
    "@ai-sdk/openai": "^4.0.99",
    "@ai-sdk/openai-compatible": "^3.0.75",
    "@ai-sdk/xai": "^5.0.27",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ai": "^7.0.148",
    "better-sqlite3": "^13.0.3",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  }
}
